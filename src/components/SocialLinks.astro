---
import Icon, { type IconName } from './Icon.astro';
import type { Site } from '../lib/schemas';
import { linkHref } from '../lib/links';

interface Props {
  socials: Site['socials'];
  email?: string;
  size?: 'large' | 'small';
}
const { socials, email = '', size = 'large' } = Astro.props;
const items: { icon: IconName; label: string; href: string }[] = [
  { icon: 'facebook', label: 'Facebook', href: linkHref(socials.facebook) },
  { icon: 'instagram', label: 'Instagram', href: linkHref(socials.instagram) },
  { icon: 'x', label: 'X (Twitter)', href: linkHref(socials.x) },
  { icon: 'youtube', label: 'YouTube', href: linkHref(socials.youtube) },
  { icon: 'imdb', label: 'IMDb', href: linkHref(socials.imdb) },
  { icon: 'email', label: 'Email', href: email ? `mailto:${email}` : '' },
];
const visible = items.filter((item) => item.href);
---
{visible.length > 0 && (
  <ul class:list={['socials', `socials-${size}`]}>
    {visible.map((item) => (
      <li>
        <a href={item.href} aria-label={item.label}><Icon name={item.icon} /></a>
      </li>
    ))}
  </ul>
)}

<style>
  .socials { display: flex; gap: 8px; justify-content: center; list-style: none; margin: 0; padding: 0; }
  .socials a {
    display: grid; place-items: center;
    background: var(--text); color: var(--teal-deep);
    --icon-knockout: var(--text);
  }
  .socials-large a { width: 36px; height: 36px; border-radius: 6px; font-size: 26px; }
  /* 44px tap target; the padding is transparent so the visible circle is 28px. */
  .socials-small a { width: 44px; height: 44px; padding: 8px; border-radius: 50%; background-clip: content-box; font-size: 16px; }
</style>
