---
export type IconName = 'facebook' | 'instagram' | 'x' | 'youtube' | 'imdb' | 'email' | 'play' | 'menu' | 'close';
interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className } = Astro.props;
---
<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === 'facebook' && (
    <path d="M15 3.5h-2.5A3.5 3.5 0 0 0 9 7v3H6.5v3.5H9V21h3.5v-7.5H15l.5-3.5h-3V7.5a1 1 0 0 1 1-1h1.5z" fill="currentColor" stroke="none" />
  )}
  {name === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'x' && <path d="M5 4h4l10 16h-4zM19 4l-5.8 6.6M5 20l5.8-6.6" />}
  {name === 'youtube' && (
    <>
      <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
      <path d="M10 9v6l5-3z" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'imdb' && (
    <>
      <rect x="1.5" y="6.5" width="21" height="11" rx="2" fill="currentColor" stroke="none" />
      <text x="12" y="14.6" text-anchor="middle" class="icon-knockout">IMDb</text>
    </>
  )}
  {name === 'email' && (
    <>
      <rect x="3" y="5.5" width="18" height="13" rx="2" />
      <path d="M3.5 6.5 12 13l8.5-6.5" />
    </>
  )}
  {name === 'play' && <path d="M8 5v14l11-7z" fill="currentColor" stroke="none" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
</svg>

<style>
  .icon { width: 1em; height: 1em; }
  .icon-knockout { font: 700 7px Arial, sans-serif; fill: var(--icon-knockout, #fff); stroke: none; }
</style>
